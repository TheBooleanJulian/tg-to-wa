# ── Telegram ──────────────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram channel ID (negative number, e.g. -1001234567890)
# Tip: forward a message from your channel to @username_to_id_bot to get it
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx

# ── WhatsApp ───────────────────────────────────────────────────────────────────
# Your WhatsApp group ID (format: xxxxxxxxxxx@g.us)
# Tip: run the "Get WA Group ID" snippet in README.md to find yours
WA_GROUP_ID=xxxxxxxxxxx@g.us
